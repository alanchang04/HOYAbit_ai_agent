# === LLM backend 切換 ===
# bedrock：競賽正式規定唯一合法後端，正式執行/繳交前必須設為 bedrock
# gemini：僅供尚未取得 Bedrock 存取權限時，開發階段暫代測試 prompt 用
LLM_BACKEND=bedrock

# === AWS Bedrock（必要，硬性限制：LLM 推理僅能使用 Bedrock 上的模型）===
# 本次競賽用的是 AWS Workshop Studio 臨時事件帳號，只開放 us-west-2 / us-east-1。
AWS_REGION=us-west-2
#
# ⚠ 模型 ID 必須用「推論設定檔」，不能用裸模型 id——
#   實測裸的 anthropic.claude-sonnet-4-5-... 一律回 ValidationException。
# ⚠ 也不要用綁帳號的 ARN（arn:aws:bedrock:<region>:<帳號>:inference-profile/...），
#   那種換帳號必定失效。`global.` 前綴的設定檔不綁帳號、兩個活動 region 都通。
#
# --- 2026-08-01 在主辦方帳號（149255038012）實測的可用清單 ---
#   ✅ global.anthropic.claude-opus-4-6-v1                    ← 目前採用（最強且夠快）
#   ✅ global.anthropic.claude-sonnet-4-6                     ⚠ 見下方警告
#   ✅ global.anthropic.claude-sonnet-4-5-20250929-v1:0       ← 備援
#   ❌ Fable 5 / Opus 5 / Opus 4.8 / Opus 4.7 / Sonnet 5      AccessDeniedException（主辦方未開通）
#
# ⚠ **不要用 Sonnet 4.6**：同一份負載實測單次 101.5 秒，是 Opus 4.6（16.1 秒）的 6 倍。
#   原因是 Sonnet 4.6 預設 effort=high 且開啟思考，而 Opus 4.6 與 Sonnet 4.5 預設不思考。
#   我們一次執行有 7 個連續呼叫，推算 710 秒會撞上降級門檻 720 秒、逼近硬性上限 900 秒。
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-6-v1
#
# --- Workshop Studio 憑證（臨時，會過期）---
# 事件頁左側「Get AWS CLI credentials」→ 複製三個值貼到下面。
# **三個都要**：少了 SESSION_TOKEN 一定被拒。過期就回去重按一次。
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# 設好後先驗證再做別的：
#   python scripts/check_workshop_account.py   # 探測帳號有哪些模型可用
#   python scripts/check_llm.py                # 確認實際叫得動

# === Gemini（開發階段暫代用，正式比賽不得使用）===
# 免費層每日額度是「每專案每模型」各自計算，建議申請一組獨立的 GCP 專案/API key
# 專門給這個專案用，避免跟你其他 Gemini 應用搶額度。
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# === 選用：各 collector 的補充 API key（缺少時會退回免 key 端點或標記 skipped）===
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
FRED_API_KEY=

# === 執行時間控制（秒）===
HARD_DEADLINE_SECONDS=900
DEGRADED_MODE_TRIGGER_SECONDS=720
COLLECTOR_TIMEOUT_SECONDS=75
# 單次 LLM 呼叫的 socket 讀取／連線上限。boto3 預設 read_timeout 是 60s，而實測正常
# 呼叫最慢的結論層已到 56.5s，只剩 6% 餘裕——稍慢一點就觸發 ReadTimeout，再被兩層
# 重試放大成十幾分鐘（2026-08-01 實測單次呼叫卡 1020s、整跑 1189s）。
LLM_READ_TIMEOUT_SECONDS=150
LLM_CONNECT_TIMEOUT_SECONDS=10

# === 路徑設定 ===
DATA_DIR=data
OUTPUT_DIR=output

# Reddit app 憑證（選填）。不設定時 social collector 走免 key 的 RSS 端點，
# 但 RSS 不含 score／留言數且限流很緊（每窗口 1 次）。設定後改走 OAuth，
# 可取回完整熱度欄位、額度也較寬。免費申請：https://www.reddit.com/prefs/apps
# （類型選 script，redirect uri 隨便填 http://localhost）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
